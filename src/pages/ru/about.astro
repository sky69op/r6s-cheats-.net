---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations, defaultLocale } from '../../i18n';
import { pageTitle } from '../../config/seo';
import { localizedPath } from '../../utils/path';
import LegalPage from '../../components/LegalPage.astro';
import { breadcrumbSchema, organizationSchema, webPageSchema } from '../../utils/schema';

const locale = Astro.currentLocale ?? defaultLocale;
const t = getTranslations(locale);
const content = t.legalPages.about;
---

<BaseLayout
  title={pageTitle(content.title)}
  description={content.description}
  jsonLd={[
    organizationSchema(locale),
    webPageSchema({
      name: content.title,
      description: content.description,
      url: localizedPath(locale, '/about/'),
      locale,
    }),
    breadcrumbSchema([
      { name: t.ui.breadcrumbs.home, path: localizedPath(locale, '/') },
      { name: t.footer.about, path: localizedPath(locale, '/about/') },
    ]),
  ]}
>
  <LegalPage
    title={content.title}
    description={content.description}
    breadcrumbLabel={t.footer.about}
    sections={content.sections}
  />
</BaseLayout>
