---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCheatPages, getCheatsHub } from '../../../data/products';
import { cheatTierIcons } from '../../../data/sectionIcons';
import { getTranslations, defaultLocale } from '../../../i18n';
import { pageTitle } from '../../../config/seo';
import { breadcrumbSchema, collectionPageSchema } from '../../../utils/schema';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CatalogCard from '../../../components/CatalogCard.astro';
import IconArrow from '../../../components/IconArrow.astro';
import { localizedPath } from '../../../utils/path';

const locale = Astro.currentLocale ?? defaultLocale;
const t = getTranslations(locale);
const cheatsHub = getCheatsHub(locale);
const cheatPages = getCheatPages(locale);

const breadcrumbs = [
  { name: t.ui.breadcrumbs.home, path: localizedPath(locale, '/') },
  { name: t.ui.breadcrumbs.cheats, path: localizedPath(locale, cheatsHub.path) },
];
---

<BaseLayout
  title={pageTitle(cheatsHub.title)}
  description={cheatsHub.description}
  ogImageAlt="Rainbow Six Siege cheats with aimbot, ESP and wallhack"
  jsonLd={[
    collectionPageSchema({
      name: cheatsHub.title,
      description: cheatsHub.description,
      url: localizedPath(locale, cheatsHub.path),
      locale,
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <section class="section-shell section-band pt-8">
    <div class="container mx-auto max-w-6xl ui-container">
      <Breadcrumbs items={breadcrumbs} />

      <div class="mt-6">
        <h1 class="section-title">{t.cheats.title}</h1>
        <p class="section-desc">{t.cheats.subtitle}</p>
      </div>

      <div class="card-grid card-grid-3 mt-12">
        {cheatPages.map((cheat, i) => (
          <CatalogCard
            label={cheat.tier ?? cheat.name}
            title={cheat.title}
            href={localizedPath(locale, `/cheats/${cheat.slug}/`)}
            buyUrl={cheat.buyUrl}
            features={cheat.features}
            more={cheat.more}
            icon={cheatTierIcons[cheat.name] ?? 'crosshair'}
            variant={cheat.variant}
            buyLabel={t.ui.get}
            viewLabel={t.ui.view}
            popularLabel={t.ui.popular}
            moreFeaturesLabel={t.ui.moreFeatures}
            revealDelay={i * 80}
          />
        ))}
      </div>

      <div class="mt-10">
        <a href={localizedPath(locale, '/tools/r6s-cheats/')} class="btn btn-outline">{t.tools.viewAll}<IconArrow /></a>
      </div>
    </div>
  </section>
</BaseLayout>
