---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/HeroSection.astro';
import FeaturesSection from '../../components/FeaturesSection.astro';
import CheatsSection from '../../components/CheatsSection.astro';
import ToolsSection from '../../components/ToolsSection.astro';
import ForumsSection from '../../components/ForumsSection.astro';
import ContentSections from '../../components/ContentSections.astro';
import { getTranslations, defaultLocale } from '../../i18n';
import { faqPageSchema, organizationSchema, webPageSchema, websiteSchema } from '../../utils/schema';
import { DEFAULT_OG_IMAGE } from '../../config/seo';
import { localizedPath } from '../../utils/path';
import { getLandingFaqs } from '../../data/faq';

const locale = Astro.currentLocale ?? defaultLocale;
const t = getTranslations(locale);
const landingFaqs = getLandingFaqs(locale);
---

<BaseLayout
  title={t.site.title}
  description={t.site.description}
  jsonLd={[
    websiteSchema(locale),
    organizationSchema(locale),
    webPageSchema({
      name: t.site.title,
      description: t.site.description,
      url: localizedPath(locale, '/'),
      locale,
      primaryImage: DEFAULT_OG_IMAGE,
    }),
    faqPageSchema(landingFaqs.map((f, i) => ({ num: String(i + 1).padStart(2, '0'), q: f.q, a: f.a.replace(/<[^>]+>/g, '') }))),
  ]}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/images/hero/hero-operator-dark-640.webp"
    imagesrcset="/images/hero/hero-operator-dark-512.webp 512w, /images/hero/hero-operator-dark-640.webp 640w, /images/hero/hero-operator-dark-960.webp 960w"
    imagesizes="(min-width: 1024px) 490px, 100vw"
    fetchpriority="high"
  />
  <HeroSection />
  <main class="home-main">
    <CheatsSection />
    <ToolsSection />
    <FeaturesSection />
    <ForumsSection />
    <ContentSections />
  </main>
</BaseLayout>
