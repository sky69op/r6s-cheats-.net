---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  blogPosts,
  getFeaturedBlogPost,
  getNonFeaturedBlogPosts,
} from '../../data/blog';
import { t } from '../../i18n';
import { pageTitle } from '../../config/seo';
import { breadcrumbSchema, collectionPageSchema } from '../../utils/schema';
import { CARD_IMAGE_WIDTHS, webpSrc } from '../../utils/responsiveImage';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import BlogCard from '../../components/BlogCard.astro';
import Icon from '../../components/icons/Icon.astro';
import IconArrow from '../../components/IconArrow.astro';
import { blogPostPath } from '../../utils/path';

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog/' },
];

const featured = getFeaturedBlogPost();
const gridPosts = getNonFeaturedBlogPosts();
const lcpImage = webpSrc(featured?.image ?? blogPosts[0]!.image, CARD_IMAGE_WIDTHS[0]);
---

<BaseLayout
  title={pageTitle('R6S Cheats Guides')}
  description={t.blog.subtitle}
  jsonLd={[
    collectionPageSchema({
      name: t.blog.title,
      description: t.blog.subtitle,
      url: '/blog/',
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <link slot="head" rel="preload" as="image" href={lcpImage} type="image/webp" fetchpriority="high" />

  <section class="section-shell">
    <div class="container section-center">
      <div class="max-w-5xl text-left">
        <Breadcrumbs items={breadcrumbs} />
      </div>
      <SectionHeader eyebrow={t.blog.eyebrow} title={t.blog.title} desc={t.blog.subtitle} />

      {featured && (
        <article class="blog-featured max-w-5xl">
          <a href={blogPostPath(featured.slug)} class="blog-featured-media block" tabindex="-1" aria-hidden="true">
            <ResponsiveImage
              src={featured.image}
              alt={featured.title}
              width={960}
              height={540}
              loading="eager"
              fetchPriority="high"
              sizes="(min-width: 768px) 560px, 100vw"
              class="h-full w-full object-cover"
            />
          </a>
          <div class="blog-featured-body">
            <span class="blog-featured-label">Featured</span>
            <h2 class="blog-featured-title">
              <a href={blogPostPath(featured.slug)} class="hover:text-[var(--accent-hover)]">
                {featured.title}
              </a>
            </h2>
            <div class="blog-card-meta mt-4">
              <span class="blog-meta-item">
                <Icon name="calendar" size={13} />
                {featured.date}
              </span>
              <span class="blog-meta-item">
                <Icon name="clock" size={13} />
                {featured.readTime}
              </span>
            </div>
            <a href={blogPostPath(featured.slug)} class="btn btn-primary blog-card-btn mt-auto">
              Read featured guide
              <IconArrow />
            </a>
          </div>
        </article>
      )}

      <div class="card-grid card-grid-3 mt-12 max-w-5xl text-left">
        {gridPosts.map((post, index) => (
          <BlogCard post={post} index={index} />
        ))}
      </div>

      <div class="mt-10">
        <a href="/" class="btn btn-outline">
          <Icon name="chevronLeft" size={16} />
          Back to home
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
