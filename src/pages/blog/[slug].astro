---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n';
import { getAllBlogSlugs, getBlogPost, getRelatedBlogPosts } from '../../data/blog';
import { pageTitle } from '../../config/seo';
import {
  articleSchema,
  breadcrumbSchema,
  parseBlogDate,
} from '../../utils/schema';
import { checkoutPath, resolveCheckoutHref } from '../../config/affiliate';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import BlogSidebar from '../../components/BlogSidebar.astro';
import FaqSection from '../../components/FaqSection.astro';
import { getBlogFaqs } from '../../data/faq';
import Icon from '../../components/icons/Icon.astro';
import IconArrow from '../../components/IconArrow.astro';
import type { BlogBlock } from '../../data/blog';

export function getStaticPaths() {
  return getAllBlogSlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const post = getBlogPost(slug!);

if (!post) {
  return Astro.redirect('/blog/');
}

const postPath = `/blog/${post.slug}/`;
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog/' },
  { name: post.title, path: postPath },
];

const related = getRelatedBlogPosts(post.slug, 3);

function linkify(text: string): string {
  return text
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>')
    .replace(/(https:\/\/r6scheats\.net[^\s.,;)]*)/g, '<a href="$1">$1</a>');
}

function slugify(text: string): string {
  return text
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
}
const published = parseBlogDate(post.date);
---

<BaseLayout
  title={pageTitle(post.title)}
  description={post.desc}
  ogType="article"
  ogImage={post.image}
  ogImageAlt={post.title}
  articlePublishedTime={published}
  articleModifiedTime={published}
  jsonLd={[
    articleSchema({
      name: post.title,
      description: post.desc,
      url: postPath,
      image: post.image,
      datePublished: published,
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <article class="section-shell">
    <div class="container mx-auto max-w-6xl">
      <Breadcrumbs items={breadcrumbs} />

      <div class="blog-post-layout mt-6">
        <div class="min-w-0">
          <div class="overflow-hidden rounded-[var(--radius-lg)] border border-[var(--border)]">
            <ResponsiveImage
              src={post.image}
              alt={post.title}
              width={960}
              height={540}
              loading="eager"
              fetchPriority="high"
              sizes="(min-width: 768px) 720px, 100vw"
              class="w-full object-cover"
            />
          </div>

          <header class="mt-8">
            <span class="blog-card-badge">
              <Icon name="tag" size={12} />
              {post.tag}
            </span>
            <h1 class="mt-4 text-left font-[family-name:var(--font-heading)] text-[clamp(1.75rem,4vw,2.25rem)] font-bold leading-tight text-[var(--text)] normal-case">
              {post.title}
            </h1>
            <p class="mt-4 text-lg leading-relaxed text-[var(--text-muted)]">{post.desc}</p>
            <div class="mt-6 flex flex-wrap items-center gap-4 border-t border-[var(--border)] pt-6">
              <div class="blog-meta">
                {post.author && (
                  <span class="blog-meta-item">
                    <Icon name="users" size={14} />
                    {post.author}
                  </span>
                )}
                <span class="blog-meta-item">
                  <Icon name="calendar" size={14} />
                  {post.date}
                </span>
                <span class="blog-meta-item">
                  <Icon name="clock" size={14} />
                  {post.readTime}
                </span>
              </div>
            </div>
          </header>

          <div class="blog-prose mt-10">
            {post.body.map((block: BlogBlock) => {
              if (block.type === 'h2') {
                const id = slugify(block.text);
                return <h2 id={id}>{block.text}</h2>;
              }
              if (block.type === 'h3') {
                const id = slugify(block.text);
                return <h3 id={id}>{block.text}</h3>;
              }
              if (block.type === 'ul') {
                return (
                  <ul>
                    {block.items.map((item) => (
                      <li set:html={linkify(item)} />
                    ))}
                  </ul>
                );
              }
              if (block.type === 'table') {
                return (
                  <div class="blog-prose-table-wrap">
                    <table>
                      <thead>
                        <tr>
                          {block.headers.map((header) => (
                            <th>{header}</th>
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {block.rows.map((row) => (
                          <tr>
                            {row.map((cell) => (
                              <td set:html={linkify(cell)} />
                            ))}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                );
              }
              if (block.type === 'cta') {
                return (
                  <div class="blog-cta-block">
                    <h3>{block.title}</h3>
                    <p set:html={linkify(block.text)} />
                    <a href={resolveCheckoutHref(block.href)}>Buy now →</a>
                  </div>
                );
              }
              return <p set:html={linkify(block.text)} />;
            })}
          </div>

          <div class="mt-12 flex flex-col gap-3 border-t border-[var(--border)] pt-8 sm:flex-row">
            <a href={checkoutPath('dota2')} class="btn btn-primary flex-1" aria-label={t.ui.checkoutAria}>
              Buy R6S Cheats
            </a>
            <a href="/products/r6s-cheats/" class="btn btn-outline flex-1">
              View products
            </a>
            <a href="/blog/" class="btn btn-outline flex-1">
              More articles
              <IconArrow />
            </a>
          </div>
        </div>

        <BlogSidebar post={post} related={related} />
      </div>
    </div>
  </article>

  <FaqSection
    items={getBlogFaqs(post.tag, post.slug)}
    eyebrow="Article FAQ"
    title="Questions about this guide"
    subtitle="Quick answers related to this topic—plus links to tier pages when relevant."
    titleId={`blog-faq-${post.slug}`}
    class="section-band"
  />
</BaseLayout>

<style>
  .blog-prose h2 {
    font-family: var(--font-heading);
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    text-transform: none;
    color: var(--text);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    scroll-margin-top: 5.5rem;
  }

  .blog-prose h3 {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--text);
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    scroll-margin-top: 5.5rem;
  }

  .blog-prose p {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .blog-prose p a,
  .blog-prose li a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .blog-prose p a:hover,
  .blog-prose li a:hover {
    color: var(--accent-hover);
  }

  .blog-meta svg {
    stroke: var(--text);
  }
</style>
