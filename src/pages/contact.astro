---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import { pageTitle } from '../config/seo';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import IconArrow from '../components/IconArrow.astro';
import { breadcrumbSchema, webPageSchema } from '../utils/schema';

const content = t.legalPages.contact;
---

<BaseLayout
  title={pageTitle(content.title)}
  description={content.description}
  jsonLd={[
    webPageSchema({
      name: t.contact.title,
      description: t.contact.subtitle,
      url: '/contact/',
    }),
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Contact', path: '/contact/' },
    ]),
  ]}
>
  <section class="section-shell">
    <div class="container section-center">
      <div class="max-w-2xl text-left">
        <Breadcrumbs
          items={[
            { name: 'Home', path: '/' },
            { name: 'Contact', path: '/contact/' },
          ]}
        />
        <h1 class="section-title mt-4 text-left normal-case" style="text-transform: none;">
          {t.contact.title}
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-(--text-muted)">{t.contact.subtitle}</p>

        <aside class="mt-10 rounded-lg border border-(--border) bg-(--surface) p-6 text-left">
          <p class="text-sm font-semibold text-foreground">{t.contact.asideTitle}</p>
          <ul class="mt-4 space-y-4">
            {t.contact.asideItems.map((item) => (
              <li class="flex gap-3">
                <span class="faq-num">{item.num}</span>
                <div>
                  <p class="text-sm font-medium text-foreground">{item.title}</p>
                  <p class="mt-0.5 text-sm text-(--text-muted)">{item.desc}</p>
                </div>
              </li>
            ))}
          </ul>
        </aside>

        <div class="mt-10 flex flex-wrap gap-3">
          <a href="/faq/" class="btn btn-outline">
            Read FAQ
            <IconArrow />
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
