---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import { pageTitle } from '../config/seo';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/icons/Icon.astro';
import IconArrow from '../components/IconArrow.astro';
import { breadcrumbSchema, webPageSchema } from '../utils/schema';
import { AFFILIATE_URL } from '../config/affiliate';

const content = t.legalPages.contact;
---

<BaseLayout
  title={pageTitle(content.title)}
  description={content.description}
  jsonLd={[
    webPageSchema({
      name: t.contact.title,
      description: t.contact.subtitle,
      url: '/contact/',
    }),
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Contact', path: '/contact/' },
    ]),
  ]}
>
  <section class="section-shell">
    <div class="container section-center">
      <div class="max-w-2xl text-left">
        <Breadcrumbs
          items={[
            { name: 'Home', path: '/' },
            { name: 'Contact', path: '/contact/' },
          ]}
        />
        <h1 class="section-title mt-4 text-left normal-case" style="text-transform: none;">
          {t.contact.title}
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-[var(--text-muted)]">{t.contact.subtitle}</p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={t.site.discord}
            class="btn btn-discord"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={t.ui.discordAria}
          >
            <Icon name="discord" size={18} />
            {t.contact.discord}
          </a>
          <a href={AFFILIATE_URL} class="btn btn-outline">
            <Icon name="arrowUpRight" size={18} />
            {t.contact.websiteSupport}
          </a>
        </div>

        <aside class="mt-10 rounded-[var(--radius-lg)] border border-[var(--border)] bg-[var(--surface)] p-6 text-left">
          <p class="text-sm font-semibold text-[var(--text)]">{t.contact.asideTitle}</p>
          <ul class="mt-4 space-y-4">
            {t.contact.asideItems.map((item) => (
              <li class="flex gap-3">
                <span class="faq-num">{item.num}</span>
                <div>
                  <p class="text-sm font-medium text-[var(--text)]">{item.title}</p>
                  <p class="mt-0.5 text-sm text-[var(--text-muted)]">{item.desc}</p>
                </div>
              </li>
            ))}
          </ul>
        </aside>

        <div class="mt-10">
          <a href="/faq/" class="btn btn-outline">
            Read FAQ
            <IconArrow />
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
