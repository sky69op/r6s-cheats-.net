---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FeaturesSection from '../../components/FeaturesSection.astro';
import ToolkitSection from '../../components/ToolkitSection.astro';
import { getTranslations, defaultLocale } from '../../i18n';
import { pageTitle } from '../../config/seo';
import { localizedPath } from '../../utils/path';
import { breadcrumbSchema, webPageSchema } from '../../utils/schema';

const locale = Astro.currentLocale ?? defaultLocale;
const t = getTranslations(locale);

const breadcrumbs = [
  { name: t.ui.breadcrumbs.home, path: localizedPath(locale, '/') },
  { name: t.ui.breadcrumbs.features, path: localizedPath(locale, '/features/') },
];
---

<BaseLayout
  title={pageTitle(t.features.pageTitle)}
  description={t.features.pageDescription}
  jsonLd={[
    webPageSchema({
      name: t.features.pageTitle,
      description: t.features.pageDescription,
      url: localizedPath(locale, '/features/'),
      locale,
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <section class="section-shell section-band pt-8">
    <div class="container section-center ui-container">
      <Breadcrumbs items={breadcrumbs} />
      <h1 id="features-page-title" class="section-title mt-4">{t.features.title}</h1>
      <p class="section-desc">{t.features.subtitle}</p>
    </div>
  </section>

  <FeaturesSection showHeader={false} showSeeAll={false} sectionId="features-list" />
  <ToolkitSection sectionId="software" />
</BaseLayout>
