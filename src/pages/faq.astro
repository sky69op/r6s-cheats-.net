---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllFaqs } from '../data/faq';
import { pageTitle } from '../config/seo';
import { breadcrumbSchema, faqPageSchema, webPageSchema } from '../utils/schema';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FaqSection from '../components/FaqSection.astro';

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'FAQ', path: '/faq/' },
];

const faqs = getAllFaqs();
---

<BaseLayout
  title={pageTitle('FAQ — R6S Cheats & Tools')}
  description="Answers about Rainbow Six Siege cheat tiers, ESP, aimbot, HWID utilities, forum threads and checkout at r6scheats.net."
  jsonLd={[
    webPageSchema({
      name: 'FAQ — R6S Cheats & Tools',
      description:
        'Answers about Rainbow Six Siege cheat tiers, ESP, aimbot, HWID utilities, forum threads and checkout at r6scheats.net.',
      url: '/faq/',
    }),
    faqPageSchema(faqs.map((f, i) => ({ num: String(i + 1).padStart(2, '0'), q: f.q, a: f.a.replace(/<[^>]+>/g, '') }))),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <section class="section-shell faq-page pt-8">
    <div class="container faq-section__container">
      <Breadcrumbs items={breadcrumbs} />
      <h1 id="faq-page-title" class="faq-page__title">FAQ</h1>
    </div>
  </section>

  <FaqSection
    items={faqs}
    titleId="faq-page-title"
    showHeader={false}
    layout="left"
    showFilters
    filterTopics={['all', 'plans', 'esp', 'scripts', 'safety', 'tools', 'forums', 'setup']}
    class="faq-page__list"
  />
</BaseLayout>

<style>
  .faq-page__title {
    margin-top: 1.5rem;
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--text);
    text-align: left;
    text-transform: none;
  }

  .faq-page__list {
    padding-top: 0;
  }
</style>
