---
import { getAffiliateReflink, CHECKOUT_SLUG_TO_PRODUCT } from '../../config/affiliate';
import { t } from '../../i18n';

export function getStaticPaths() {
  return Object.keys(CHECKOUT_SLUG_TO_PRODUCT).map((product) => ({ params: { product } }));
}

const slug = Astro.params.product!;
const key = CHECKOUT_SLUG_TO_PRODUCT[slug];

if (!key) {
  return Astro.redirect('/');
}

const destination = getAffiliateReflink(key);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <script is:inline define:vars={{ destination }}>
      location.replace(destination);
    </script>
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <title>{t.site.name}</title>
  </head>
  <body></body>
</html>
