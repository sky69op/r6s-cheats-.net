---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import FeaturesSection from '../components/FeaturesSection.astro';
import WhySetupSection from '../components/WhySetupSection.astro';
import CheatsSection from '../components/CheatsSection.astro';
import ProductsSection from '../components/ProductsSection.astro';
import ContentSections from '../components/ContentSections.astro';
import { t } from '../i18n';
import { faqPageSchema, organizationSchema, websiteSchema } from '../utils/schema';
import { getLandingFaqs } from '../data/faq';
import { webpSrc } from '../utils/responsiveImage';

const landingFaqs = getLandingFaqs();
const heroLcpImage = webpSrc('/images/gameplay/r6s-esp.png', 512);
---

<BaseLayout
  title={t.site.title}
  description={t.site.description}
  jsonLd={[websiteSchema(), organizationSchema(), faqPageSchema(landingFaqs.map((f, i) => ({ num: String(i + 1).padStart(2, '0'), q: f.q, a: f.a.replace(/<[^>]+>/g, '') })))]}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={heroLcpImage}
    type="image/webp"
    fetchpriority="high"
  />
  <HeroSection />
  <CheatsSection />
  <ProductsSection />
  <FeaturesSection />
  <WhySetupSection />
  <ContentSections />
</BaseLayout>
