---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import IconArrow from '../components/IconArrow.astro';
---

<BaseLayout title={`Page not found | ${t.site.name}`} description="The page you requested could not be found on r6scheats.net." noindex={true}>
  <section class="section-shell">
    <div class="container section-center">
      <p class="section-label">404</p>
      <h1 class="section-title mt-3">Page not found</h1>
      <p class="mt-4 max-w-md text-[var(--text-muted)]">
        That URL does not exist or may have moved. Head back to the homepage or browse cheat tiers and products.
      </p>
      <div class="mt-8 flex flex-wrap justify-start gap-3">
        <a href="/" class="btn btn-primary">
          Back to home
          <IconArrow />
        </a>
        <a href="/products/r6s-cheats/" class="btn btn-outline">View products</a>
        <a href="/cheats/" class="btn btn-outline">Browse cheats</a>
      </div>
    </div>
  </section>
</BaseLayout>
