---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  getAllCheatSlugs,
  getCheatPage,
  getCheatsHub,
  getCheatSeoDescription,
  getCheatSeoTitle,
} from '../../../data/products';
import { getTranslations, defaultLocale } from '../../../i18n';
import { pageTitle } from '../../../config/seo';
import { localizedPath } from '../../../utils/path';
import {
  breadcrumbSchema,
  softwareApplicationSchema,
} from '../../../utils/schema';
import CheatTierDetail from '../../../components/cheat-tier/CheatTierDetail.astro';

export function getStaticPaths() {
  return getAllCheatSlugs().map((slug) => ({ params: { slug } }));
}

const locale = Astro.currentLocale ?? defaultLocale;
const t = getTranslations(locale);
const { slug } = Astro.params;
const cheatsHub = getCheatsHub(locale);
const product = getCheatPage(slug!, locale);

if (!product) {
  return Astro.redirect(localizedPath(locale, cheatsHub.path));
}

const pagePath = localizedPath(locale, `${cheatsHub.path}${product.slug}/`);
const seoTitle = getCheatSeoTitle(product.slug, locale, product.title);
const seoDescription = getCheatSeoDescription(product.slug, locale, product.desc);
const breadcrumbs = [
  { name: t.ui.breadcrumbs.home, path: localizedPath(locale, '/') },
  { name: t.ui.breadcrumbs.cheats, path: localizedPath(locale, cheatsHub.path) },
  { name: product.name, path: pagePath },
];
---

<BaseLayout
  title={pageTitle(seoTitle)}
  description={seoDescription}
  ogImage={product.images[0]?.src}
  ogImageAlt={product.images[0]?.alt ?? seoTitle}
  jsonLd={[
    softwareApplicationSchema({
      name: seoTitle,
      description: seoDescription,
      url: pagePath,
      image: product.images[0]?.src,
      locale,
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <CheatTierDetail product={product} breadcrumbs={breadcrumbs} />
</BaseLayout>
