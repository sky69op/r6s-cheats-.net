---
import type { ProductOverview, ProductPage } from '../data/products';
import Icon from './icons/Icon.astro';

interface Props {
  product: Pick<
    ProductPage,
    'fullFeatures' | 'goodToKnow' | 'limitations' | 'systemRequirements' | 'features' | 'more'
  >;
  overview?: ProductOverview;
}

const { product, overview } = Astro.props;
const totalFeatures = product.fullFeatures.length;
const isProductPage = Boolean(overview);
---

<section class:list={['product-info-section', { 'product-info-section--page': isProductPage }]} aria-label="Product details">
  {
    isProductPage && overview && (
      <div class="product-overview-compat-grid">
        <article class="wz-card product-overview-card">
          <div class="wz-card-body">
            <div class="product-info-section-head">
              <Icon name="layers" size={16} />
              <p class="product-info-label">Overview</p>
            </div>
            <h2 class="product-overview-card-title">{overview.title}</h2>
            <div class="product-overview-card-copy">
              {overview.paragraphs.map((paragraph, index) => (
                <p class:list={[{ 'product-overview-lead': index === 0 }]}>{paragraph}</p>
              ))}
            </div>
          </div>
        </article>

        <aside class="wz-card product-compat-card">
          <div class="wz-card-body">
            <div class="product-info-section-head">
              <Icon name="cpu" size={16} />
              <p class="product-info-label">Compatibility</p>
            </div>
            <h2 class="card-title mt-1 text-base normal-case" style="text-transform: none;">System requirements</h2>
            <ul class="product-req-list mt-4" role="list">
              {product.systemRequirements.map((req) => (
                <li class="product-req-item">
                  <span class="product-req-icon" aria-hidden="true">
                    <Icon name={req.icon} size={16} />
                  </span>
                  <span>{req.text}</span>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      </div>
    )
  }

  <div class="product-info-grid">
    <div class="product-info-main">
      <div class="product-info-dual wz-card">
        <div class="wz-card-body product-info-dual-body">
          <div>
            <div class="product-info-section-head">
              <Icon name="alert" size={16} />
              <p class="product-info-label">Good to know</p>
            </div>
            <p class="product-info-text">{product.goodToKnow}</p>
          </div>
          <div>
            <div class="product-info-section-head">
              <Icon name="shield" size={16} />
              <p class="product-info-label">Important limitations</p>
            </div>
            <p class="product-info-text">{product.limitations}</p>
          </div>
        </div>
      </div>
    </div>

    {
      !isProductPage && (
        <aside class="product-info-sidebar">
          <div class="wz-card product-feature-panel">
            <div class="wz-card-body">
              <div class="product-feature-panel-head">
                <div>
                  <p class="product-info-label">Included capabilities</p>
                  <h2 class="card-title text-lg normal-case" style="text-transform: none;">Complete feature list</h2>
                </div>
                <span class="badge">{totalFeatures} total</span>
              </div>
              <ul class="product-feature-list" role="list">
                {product.fullFeatures.map((feature, i) => (
                  <li class="product-feature-item">
                    <span class="product-feature-check" aria-hidden="true">
                      <Icon name="check" size={16} />
                    </span>
                    <span class="product-feature-name">{feature}</span>
                    <span class="product-feature-num">{String(i + 1).padStart(2, '0')}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="wz-card mt-4">
            <div class="wz-card-body">
              <div class="product-info-section-head">
                <Icon name="cpu" size={16} />
                <p class="product-info-label">Compatibility</p>
              </div>
              <h2 class="card-title mt-1 text-base normal-case" style="text-transform: none;">System requirements</h2>
              <ul class="product-req-list mt-4" role="list">
                {product.systemRequirements.map((req) => (
                  <li class="product-req-item">
                    <span class="product-req-icon" aria-hidden="true">
                      <Icon name={req.icon} size={16} />
                    </span>
                    <span>{req.text}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </aside>
      )
    }
  </div>

  {
    isProductPage && (
      <div class="wz-card product-feature-panel product-feature-panel--full">
        <div class="wz-card-body">
          <div class="product-feature-panel-head">
            <div>
              <p class="product-info-label">Included capabilities</p>
              <h2 class="card-title text-lg normal-case" style="text-transform: none;">Complete feature list</h2>
            </div>
            <span class="badge">{totalFeatures} total</span>
          </div>
          <ul class="product-feature-list product-feature-list--grid" role="list">
            {product.fullFeatures.map((feature, i) => (
              <li class="product-feature-item">
                <span class="product-feature-check" aria-hidden="true">
                  <Icon name="check" size={16} />
                </span>
                <span class="product-feature-name">{feature}</span>
                <span class="product-feature-num">{String(i + 1).padStart(2, '0')}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    )
  }
</section>
