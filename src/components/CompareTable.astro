---
import { cheatPages } from '../data/products';
import { cheatTierIcons } from '../data/sectionIcons';
import Icon from './icons/Icon.astro';
import { cheatPath } from '../utils/path';

interface CompareRow {
  feature: string;
  icon: 'eye' | 'crosshair' | 'check' | 'zap' | 'package' | 'shield';
  lite: boolean;
  pro: boolean;
  elite: boolean;
}

interface Props {
  rows: CompareRow[];
  highlightSlug?: string;
}

const { rows, highlightSlug } = Astro.props;

const tiers = cheatPages.map((c) => ({
  slug: c.slug,
  name: c.name,
  icon: cheatTierIcons[c.name] ?? 'crosshair',
  href: cheatPath(c.slug),
}));
---

<section class="compare-section" aria-labelledby="compare-heading">
  <h2 id="compare-heading" class="compare-section__title">Compare all plans</h2>
  <p class="compare-section__desc">Side-by-side look at what each tier includes.</p>

  <div class="compare-table-wrap" tabindex="0" aria-label="Compare all plans">
    <div class="compare-table-scroll">
      <table class="compare-table">
        <thead>
          <tr>
            <th scope="col" class="compare-table__feature-col compare-table__feature-col--head">
              <div class="compare-table__plan-head">
                <div class="compare-table__plan compare-table__plan--static">
                  <span class="compare-table__plan-icon" aria-hidden="true">
                    <Icon name="package" size={22} />
                  </span>
                  <span class="compare-table__plan-name">Feature</span>
                </div>
              </div>
            </th>
            {tiers.map((tier) => (
              <th
                scope="col"
                class:list={[
                  'compare-table__plan-col',
                  { 'compare-table__plan-col--popular': tier.slug === 'pro' },
                ]}
              >
                <div class="compare-table__plan-head">
                  {tier.slug === 'pro' && <span class="compare-table__popular">Popular</span>}
                  <a
                    href={tier.href}
                    class:list={[
                      'compare-table__plan',
                      { 'compare-table__plan--current': highlightSlug === tier.slug },
                    ]}
                  >
                    <span class="compare-table__plan-icon" aria-hidden="true">
                      <Icon name={tier.icon} size={22} />
                    </span>
                    <span class="compare-table__plan-name">{tier.name}</span>
                  </a>
                </div>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr>
              <th scope="row" class="compare-table__feature-col">
                <span class="compare-table__feature">
                  <span class="compare-table__feature-icon" aria-hidden="true">
                    <Icon name={row.icon} size={15} />
                  </span>
                  <span>{row.feature}</span>
                </span>
              </th>
              {(['lite', 'pro', 'elite'] as const).map((slug) => {
                const included = row[slug];
                return (
                  <td class="compare-table__value-col">
                    <span
                      class:list={[
                        'compare-table__cell',
                        included ? 'compare-table__cell--yes' : 'compare-table__cell--no',
                      ]}
                      aria-label={included ? 'Included' : 'Not included'}
                    >
                      <Icon name={included ? 'circleCheck' : 'x'} size={18} />
                    </span>
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
