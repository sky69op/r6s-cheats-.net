---
interface Props {
  eyebrow: string;
  title: string;
  desc?: string;
  titleId?: string;
  centered?: boolean;
}

const { eyebrow, title, desc, titleId, centered = false } = Astro.props;
---

<header class:list={['section-header', { 'section-header-center': centered }]} data-reveal>
  <p class="section-label">{eyebrow}</p>
  <h2 id={titleId} class="section-title">{title}</h2>
  {desc && <p class="section-desc">{desc}</p>}
</header>
