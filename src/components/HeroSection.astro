---
import { getTranslations, defaultLocale } from '../i18n';
import Icon from './icons/Icon.astro';
import IconArrow from './IconArrow.astro';

const locale = Astro.currentLocale ?? defaultLocale;
const t = getTranslations(locale);
const h = t.hero;
---

<section id="hero" class="hero-section" aria-labelledby="hero-title">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-bg-mesh">
      <span class="hero-bg-blob hero-bg-blob--1"></span>
      <span class="hero-bg-blob hero-bg-blob--2"></span>
      <span class="hero-bg-blob hero-bg-blob--3"></span>
    </div>
    <div class="hero-bg-grid"></div>
    <div class="hero-bg-spotlight"></div>
    <div class="hero-bg-noise"></div>
    <div class="hero-bg-vignette"></div>
  </div>

  <div class="container hero-inner">
    <div class="hero-layout">
      <div class="hero-content">
        <p class="hero-eyebrow">{h.eyebrow}</p>

        <h1 id="hero-title" class="hero-title">
          <span class="hero-title-line">{h.titleLine1}</span>
          <span class="hero-title-accent">{h.titleLine2}</span>
        </h1>

        <p class="hero-subtitle">{h.subtitle}</p>

        <div class="hero-actions">
          <a href="#cheats" class="btn btn-primary hero-btn">
            {h.ctaPrimary}
            <IconArrow />
          </a>
        </div>
      </div>

      <div class="hero-visual" aria-hidden="true">
        <div class="hero-operator-stack">
          <img
            src="/images/hero/hero-operator-dark.png"
            alt=""
            class="hero-character hero-character--dark"
            width="802"
            height="1024"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
          <img
            src="/images/hero/hero-operator-light.png"
            alt=""
            class="hero-character hero-character--light"
            width="803"
            height="1024"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>

    <div class="hero-status-marquee" aria-label="Feature status">
      <div class="hero-status-marquee-track">
        {[0, 1].map((copy) => (
          <div class="hero-status-marquee-group" aria-hidden={copy === 1 ? 'true' : undefined}>
            {h.statusPills.map((pill) => (
              <span class="hero-status-pill">
                <Icon name={pill.icon} size={14} />
                {pill.label}
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
