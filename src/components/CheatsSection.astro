---
import { getTranslations, defaultLocale } from '../i18n';
import { getCheatPages } from '../data/products';
import { cheatTierIcons } from '../data/sectionIcons';
import SectionHeader from './SectionHeader.astro';
import CatalogCard from './CatalogCard.astro';
import { cheatPath } from '../utils/path';

const locale = Astro.currentLocale ?? defaultLocale;
const t = getTranslations(locale);
const s = t.cheats;
const cheatPages = getCheatPages(locale);
---

<section id="cheats" class="section-shell section-band" aria-labelledby="cheats-title">
  <div class="container section-center">
    <SectionHeader eyebrow={s.eyebrow} title={s.title} desc={s.subtitle} titleId="cheats-title" />

    <div class="card-grid card-grid-3 mt-12" data-reveal-group>
      {cheatPages.map((cheat, i) => (
        <CatalogCard
          label={cheat.tier ?? cheat.name}
          title={cheat.title}
          href={cheatPath(cheat.slug, locale)}
          buyUrl={cheat.buyUrl}
          features={cheat.features}
          more={cheat.more}
          icon={cheatTierIcons[cheat.name] ?? 'crosshair'}
          variant={cheat.variant}
          buyLabel={t.ui.get}
          viewLabel={t.ui.view}
          popularLabel={t.ui.popular}
          moreFeaturesLabel={t.ui.moreFeatures}
          revealDelay={i * 80}
        />
      ))}
    </div>
  </div>
</section>
