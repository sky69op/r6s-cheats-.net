---
import type { ProductAcquisition, ProductOverview, ProductSlide } from '../data/products';
import { acquisitionStepIcons } from '../data/sectionIcons';
import Icon from './icons/Icon.astro';
import IconArrow from './IconArrow.astro';

interface Props {
  overview: ProductOverview;
  acquisition: ProductAcquisition;
  buyUrl: string;
  sliderId?: string;
  images?: ProductSlide[];
}

const { overview, acquisition, buyUrl } = Astro.props;
---

<div class="product-hero-grid">
  <div class="product-hero-overview text-left">
    <p class="section-label">Overview</p>
    <h1 class="product-hero-title">{overview.title}</h1>
    {overview.paragraphs.map((p) => (
      <p class="product-overview-copy">{p}</p>
    ))}
  </div>

  <div class="product-hero-acquisition text-left">
    <p class="section-label">Acquisition</p>
    <h2 class="product-acquisition-title">{acquisition.title}</h2>

    <a href={buyUrl} class="btn btn-primary btn-buy w-full mt-6">
      Buy Now
      <IconArrow />
    </a>

    <ol class="acquisition-steps">
      {acquisition.steps.map((step, i) => (
        <li class="acquisition-step">
          <span class="acquisition-step-icon" aria-hidden="true">
            <Icon name={acquisitionStepIcons[i] ?? 'check'} size={18} />
          </span>
          <div>
            <p class="acquisition-step-title">{step.title}</p>
            <p class="acquisition-step-desc">{step.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</div>
