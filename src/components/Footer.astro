---
import { t } from '../i18n';

const resourceLinks = [
  { href: '/blog/', label: 'Blog archive', ariaLabel: 'Blog' },
  { href: '/cheats/', label: 'Cheats hub', ariaLabel: 'Cheats' },
  { href: '/products/r6s-cheats/', label: 'Product catalog', ariaLabel: 'Products' },
  { href: '/contact/', label: t.footer.contact },
];

const legalLinks = [
  { href: '/about/', label: t.footer.about },
  { href: '/privacy/', label: t.footer.privacy },
];
---

<footer class="site-footer section-band">
  <div class="container site-footer__inner">
    <div class="site-footer-grid">
      <div class="site-footer-brand">
        <a href="/" class="site-logo-link inline-flex items-center gap-2.5" aria-label={t.ui.homeAria}>
          <img src="/logo.svg" alt="" width="32" height="32" class="site-logo-link__img" style="border-radius: 6px;" />
          <span class="logo-text" aria-hidden="true">R6s<span class="logo-accent">Cheats</span></span>
        </a>
        <p class="site-footer-tagline">{t.footer.tagline}</p>

        <div class="site-footer-social">
          <p class="site-footer-label">{t.footer.socialTitle}</p>
          <ul class="site-footer-links">
            {t.footer.socialLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="site-footer-link"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={link.href.includes('discord') ? t.ui.discordAria : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <nav class="site-footer-col" aria-label={t.footer.explore}>
        <p class="site-footer-label">{t.footer.explore}</p>
        <ul class="site-footer-links">
          {t.footer.exploreLinks.map((link) => (
            <li>
              <a href={link.href} class="site-footer-link" aria-label={link.ariaLabel}>{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <nav class="site-footer-col" aria-label={t.footer.support}>
        <p class="site-footer-label">{t.footer.support}</p>
        <ul class="site-footer-links">
          {resourceLinks.map((link) => (
            <li>
              <a href={link.href} class="site-footer-link" aria-label={link.ariaLabel}>{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <nav class="site-footer-col" aria-label={t.footer.externalTitle}>
        <p class="site-footer-label">{t.footer.externalTitle}</p>
        <ul class="site-footer-links">
          {t.footer.externalLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="site-footer-link"
                target="_blank"
                rel="noopener noreferrer"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>

        <p class="site-footer-label site-footer-label--spaced">{t.footer.legal}</p>
        <ul class="site-footer-links">
          {legalLinks.map((link) => (
            <li>
              <a href={link.href} class="site-footer-link">{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="site-footer-bottom">
      <p class="site-footer-copy">
        &copy; {new Date().getFullYear()} {t.site.name} · {t.site.domain}
      </p>
      <p class="site-footer-disclaimer">{t.footer.disclaimer}</p>
    </div>
  </div>
</footer>
