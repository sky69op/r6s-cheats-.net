---
import { getTranslations, defaultLocale } from '../i18n';
import { localeLabels, locales } from '../i18n/config';
import { localizedPath } from '../utils/path';

const locale = Astro.currentLocale ?? defaultLocale;
const t = getTranslations(locale);
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__col site-footer__col--brand">
      <div class="site-footer__brand">
        <a href={localizedPath(locale, '/')} class="site-footer__brand-link" aria-label={t.ui.footerHomeAria}>
          <span class="site-footer__brand-logo-wrap" aria-hidden="true">
            <img
              src="/favicon-32.png"
              alt={t.ui.logoAlt}
              width="32"
              height="32"
              class="site-footer__brand-logo theme-logo theme-logo--dark"
              decoding="async"
            />
            <img
              src="/favicon-32-light.png"
              alt={t.ui.logoAlt}
              aria-hidden="true"
              width="32"
              height="32"
              class="site-footer__brand-logo theme-logo theme-logo--light"
              decoding="async"
            />
          </span>
          <span class="site-footer__brand-name logo-text">
            <span class="sr-only">{t.ui.footerBrandPrefix}</span>
            R6s<span class="logo-accent">Cheats</span>
          </span>
        </a>
      </div>
      <p class="site-footer__tagline">{t.footer.tagline}</p>
    </div>

    <nav class="site-footer__col" aria-label={t.footer.explore}>
      <p class="site-footer__label">{t.footer.explore}</p>
      <ul class="site-footer__links">
        {
          t.footer.exploreLinks.map((link) => (
            <li>
              <a href={localizedPath(locale, link.href)} aria-label={link.ariaLabel}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav class="site-footer__col" aria-label={t.footer.helpLegal}>
      <p class="site-footer__label">{t.footer.helpLegal}</p>
      <ul class="site-footer__links">
        {
          t.footer.helpLegalLinks.map((link) => (
            <li>
              <a href={localizedPath(locale, link.href)} aria-label={link.ariaLabel}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav class="site-footer__col" aria-label={t.ui.language}>
      <p class="site-footer__label">{t.ui.language}</p>
      <ul class="site-footer__links">
        {
          locales.map((code) => (
            <li>
              <a
                href={localizedPath(code, '/')}
                hreflang={code}
                lang={code}
                aria-label={`${localeLabels[code]} (${t.ui.language})`}
              >
                <span class="sr-only">{t.ui.footerLanguagePrefix}</span>
                {localeLabels[code]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="container site-footer__bottom">
    <div class="site-footer__legal">
      <p class="site-footer__copyright">
        &copy; {new Date().getFullYear()}
        <span class="site-footer__copyright-brand logo-text">
          R6s<span class="logo-accent">Cheats</span>
        </span>.
        {t.footer.rightsReserved}
      </p>
      <nav class="site-footer__legal-nav" aria-label="Legal and site links">
        <ul>
          {
            t.footer.bottomLinks.map((link) => (
              <li>
                <a href={localizedPath(locale, link.href)} aria-label={link.ariaLabel}>{link.label}</a>
              </li>
            ))
          }
          {
            t.footer.externalLinks.map((link) => (
              <li>
                <a href={link.href} rel="noopener noreferrer" target="_blank" aria-label={link.ariaLabel}>
                  {link.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href="#" class="site-footer__back-top" data-back-to-top>{t.ui.backToTop}</a>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</footer>

<script is:inline>
  (function () {
    var light = document.documentElement.getAttribute('data-color-mode') === 'light';
    document.querySelectorAll('.site-footer__brand-logo-wrap').forEach(function (wrap) {
      var darkLogo = wrap.querySelector('.theme-logo--dark');
      var lightLogo = wrap.querySelector('.theme-logo--light');
      if (!darkLogo || !lightLogo) return;
      darkLogo.style.display = light ? 'none' : 'block';
      lightLogo.style.display = light ? 'block' : 'none';
    });
  })();
</script>

<script>
  document.querySelectorAll('[data-back-to-top]').forEach((link) => {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  });
</script>
