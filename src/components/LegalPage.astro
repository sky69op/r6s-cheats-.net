---
import { getTranslations, defaultLocale } from '../i18n';
import { localizedPath } from '../utils/path';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from './icons/Icon.astro';

interface Props {
  title: string;
  description: string;
  breadcrumbLabel: string;
  sections: { heading: string; paragraphs: string[] }[];
}

const locale = Astro.currentLocale ?? defaultLocale;
const t = getTranslations(locale);
const { title, description, breadcrumbLabel, sections } = Astro.props;
---

<article class="section-shell">
  <div class="container mx-auto max-w-3xl ui-container text-left">
    <Breadcrumbs
      items={[
        { name: t.ui.breadcrumbs.home, path: localizedPath(locale, '/') },
        { name: breadcrumbLabel, path: Astro.url.pathname },
      ]}
    />
    <header class="mt-4">
      <h1 class="section-title text-left normal-case" style="text-transform: none; font-size: clamp(1.75rem, 4vw, 2.25rem);">
        {title}
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-(--text-muted)">{description}</p>
    </header>

    <div class="legal-prose mt-10">
      {sections.map((section) => (
        <section class="mt-8">
          <h2>{section.heading}</h2>
          {section.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </section>
      ))}
    </div>

    <div class="ui-cluster mt-12 border-t border-(--border) pt-8">
      <a href={localizedPath(locale, '/contact/')} class="btn btn-primary btn-sm">
        {t.footer.contact}
        <Icon name="mail" size={16} />
      </a>
      <a href={localizedPath(locale, '/')} class="btn btn-outline btn-sm">{t.ui.backToHome}</a>
    </div>
  </div>
</article>

<style>
  .legal-prose h2 {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--text);
    margin-bottom: 0.75rem;
  }

  .legal-prose p {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text-muted);
    margin-bottom: 0.875rem;
  }
</style>
