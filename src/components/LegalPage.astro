---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import { pageTitle } from '../config/seo';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from './icons/Icon.astro';

interface Props {
  title: string;
  description: string;
  breadcrumbLabel: string;
  sections: { heading: string; paragraphs: string[] }[];
}

const { title, description, breadcrumbLabel, sections } = Astro.props;
---

<article class="section-shell">
  <div class="container mx-auto max-w-3xl text-left">
    <Breadcrumbs
      items={[
        { name: 'Home', path: '/' },
        { name: breadcrumbLabel, path: Astro.url.pathname },
      ]}
    />
    <header class="mt-4">
      <h1 class="section-title text-left normal-case" style="text-transform: none; font-size: clamp(1.75rem, 4vw, 2.25rem);">
        {title}
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-[var(--text-muted)]">{description}</p>
    </header>

    <div class="legal-prose mt-10">
      {sections.map((section) => (
        <section class="mt-8">
          <h2>{section.heading}</h2>
          {section.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </section>
      ))}
    </div>

    <div class="mt-12 flex flex-wrap gap-3 border-t border-[var(--border)] pt-8">
      <a href="/contact/" class="btn btn-primary text-sm">
        Contact support
        <Icon name="mail" size={16} />
      </a>
      <a href="/" class="btn btn-outline text-sm">Back to home</a>
    </div>
  </div>
</article>

<style>
  .legal-prose h2 {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--text);
    margin-bottom: 0.75rem;
  }

  .legal-prose p {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text-muted);
    margin-bottom: 0.875rem;
  }
</style>
