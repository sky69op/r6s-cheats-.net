---
import { t } from '../i18n';
import { setupStepIcons, whyUsIcons, compatibilityIcons } from '../data/sectionIcons';
import SectionHeader from './SectionHeader.astro';
import Icon from './icons/Icon.astro';
---

<section id="why-us" class="section-shell" aria-labelledby="why-title">
  <div class="container section-center">
    <SectionHeader eyebrow={t.whyUs.eyebrow} title={t.whyUs.title} titleId="why-title" />

    <div class="card-grid card-grid-2x2 mt-12" data-reveal-group>
      {t.whyUs.items.map((item, i) => (
        <article class="wz-card" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
          <div class="wz-card-body">
            <div class="card-header-row">
              <span class="icon-wrap icon-wrap-sm">
                <Icon name={whyUsIcons[i] ?? 'shield'} size={18} />
              </span>
              <p class="card-title">{item.title}</p>
            </div>
            <p class="mt-2 text-sm leading-relaxed text-[var(--text-muted)]">{item.desc}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section id="setup-guide" class="section-shell section-band" aria-labelledby="setup-title">
  <div class="container section-center">
    <SectionHeader eyebrow={t.setup.eyebrow} title={t.setup.title} desc={t.setup.subtitle} titleId="setup-title" />

    <div class="setup-timeline mt-12" data-reveal-group>
      {t.setup.steps.map((step, i) => (
        <article class="setup-step" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
          <span class="setup-step-icon">
            <Icon name={setupStepIcons[i] ?? 'check'} size={18} />
          </span>
          <span class="setup-step-num">{step.step}</span>
          <p class="card-title mt-2">{step.title}</p>
          <p class="mt-2 text-sm text-[var(--text-muted)]">{step.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section id="compatibility" class="section-shell" aria-labelledby="compat-title">
  <div class="container section-center">
    <SectionHeader eyebrow={t.compatibility.eyebrow} title={t.compatibility.title} desc={t.compatibility.subtitle} titleId="compat-title" />

    <div class="compat-pills mt-8" role="list" aria-label="Supported platforms and features" data-reveal-group>
      {t.compatibility.items.map((item, i) => (
        <span
          class="compat-pill"
          role="listitem"
          data-reveal
          style={`--reveal-delay: ${80 + i * 70}ms`}
        >
          <Icon name={compatibilityIcons[i] ?? 'check'} size={15} />
          {item}
        </span>
      ))}
    </div>
  </div>
</section>
