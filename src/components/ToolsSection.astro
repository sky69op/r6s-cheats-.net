---
import { getTranslations, defaultLocale } from '../i18n';
import { getProductPages } from '../data/products';
import { productCategoryIcons } from '../data/sectionIcons';
import SectionHeader from './SectionHeader.astro';
import CatalogCard from './CatalogCard.astro';
import { toolPath } from '../utils/path';

const locale = Astro.currentLocale ?? defaultLocale;
const t = getTranslations(locale);
const s = t.tools;
const utilityProducts = getProductPages(locale).filter((p) => p.kind === 'utility');
---

<section id="tools" class="section-shell" aria-labelledby="tools-title">
  <div class="container section-center">
    <SectionHeader eyebrow={s.eyebrow} title={s.title} desc={s.subtitle} titleId="tools-title" />

    <div class="card-grid card-grid-3 mt-12" data-reveal-group>
      {utilityProducts.map((product, i) => (
        <CatalogCard
          label={product.category ?? 'Utility'}
          title={product.title}
          href={toolPath(product.slug, locale)}
          buyUrl={product.buyUrl}
          features={product.features}
          more={product.more}
          icon={productCategoryIcons[product.categoryKey ?? 'system_utility'] ?? 'package'}
          buyLabel={t.ui.get}
          viewLabel={t.ui.view}
          moreFeaturesLabel={t.ui.moreFeatures}
          revealDelay={i * 80}
        />
      ))}
    </div>
  </div>
</section>
