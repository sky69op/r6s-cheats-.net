---
import { getTranslations, resolveLocale } from '../i18n';
import { checkoutPath } from '../config/affiliate';
import { localizedPath } from '../utils/path';
import Icon from './icons/Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';

const locale = resolveLocale(Astro.currentLocale);
const t = getTranslations(locale);

const navIcons = {
  home: 'monitor',
  features: 'crosshair',
  cheats: 'package',
  tools: 'layers',
  forums: 'mail',
} as const;

const purchaseUrl = checkoutPath('r6s');
---

<header class="site-header">
  <div class="container site-header__bar">
    <a href={localizedPath(locale, '/')} class="site-logo-link inline-flex min-w-0 items-center gap-2" aria-label={t.ui.homeAria}>
      <span class="site-logo-link__img-wrap shrink-0" aria-hidden="true">
        <img
          src="/logo-36.webp"
          srcset="/logo-36.webp 1x, /logo-72.webp 2x"
          alt={t.ui.logoAlt}
          width="36"
          height="36"
          decoding="async"
          fetchpriority="high"
          class="site-logo-link__img theme-logo theme-logo--dark"
        />
        <img
          src="/logo-light-36.webp"
          srcset="/logo-light-36.webp 1x, /logo-light-72.webp 2x"
          alt={t.ui.logoAlt}
          aria-hidden="true"
          width="36"
          height="36"
          decoding="async"
          fetchpriority="high"
          class="site-logo-link__img theme-logo theme-logo--light"
        />
      </span>
      <span class="logo-text site-logo-link__text truncate">R6s<span class="logo-accent">Cheats</span></span>
    </a>

    <nav class="desktop-nav absolute left-1/2 hidden -translate-x-1/2 items-center gap-5 xl:gap-6 lg:flex" aria-label="Primary">
      {t.nav.map((link) => (
        <a href={localizedPath(locale, link.href)} class="nav-link" data-nav-link>{link.label}</a>
      ))}
    </nav>

    <div class="site-header__actions">
      <LanguageSwitcher locale={locale} />
      <button
        type="button"
        class="theme-toggle"
        data-theme-toggle
        data-label-light={t.ui.themeLight}
        data-label-dark={t.ui.themeDark}
        aria-label={t.ui.themeLight}
        title={t.ui.themeLight}
      >
        <svg class="theme-toggle__icon theme-toggle__icon--light" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="theme-toggle__icon theme-toggle__icon--dark" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
      <a href={purchaseUrl} class="btn btn-primary desktop-cta hidden lg:inline-flex" aria-label={t.ui.checkoutAria}>{t.ui.browseCheats}</a>
      <button
        type="button"
        class="menu-toggle"
        data-menu-toggle
        data-label-open={t.ui.menuOpen}
        data-label-close={t.ui.menuClose}
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t.ui.menuOpen}
      >
        <svg data-icon-menu width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
        <svg data-icon-close class="hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    <button type="button" class="mobile-nav-backdrop" data-mobile-backdrop aria-label={t.ui.menuClose} tabindex="-1"></button>

    <nav id="mobile-menu" class="mobile-nav" aria-label="Mobile" data-mobile-nav hidden>
      {t.nav.map((link) => (
        <a
          href={localizedPath(locale, link.href)}
          class="nav-link inline-flex items-center gap-2"
          data-mobile-link
          data-nav-link
          aria-label={`${link.label} (${t.ui.menuOpen})`}
        >
          <Icon name={navIcons[link.id ?? 'home']} size={16} />
          <span class="sr-only">{t.ui.mobileMenuPrefix}</span>
          {link.label}
        </a>
      ))}
      <a href={purchaseUrl} class="btn btn-primary mt-2 w-full justify-center" data-mobile-link aria-label={t.ui.checkoutAria}>{t.ui.browseCheatsMobile}</a>
    </nav>
  </div>
</header>
