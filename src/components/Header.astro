---
import { t } from '../i18n';
import { checkoutPath } from '../config/affiliate';
import Icon from './icons/Icon.astro';

const navIcons: Record<string, 'crosshair' | 'package' | 'layers' | 'mail' | 'monitor'> = {
  Home: 'monitor',
  Features: 'crosshair',
  Cheats: 'package',
  Tools: 'layers',
  Forums: 'mail',
};

const purchaseUrl = checkoutPath('r6s');
---

<header class="site-header">
  <div class="container site-header__bar">
    <a href="/" class="site-logo-link inline-flex min-w-0 items-center gap-2" aria-label={t.ui.homeAria}>
      <span class="site-logo-link__img-wrap shrink-0" aria-hidden="true">
        <img src="/logo.png" alt="" width="32" height="32" class="site-logo-link__img theme-logo theme-logo--dark" />
        <img src="/logo-light.png" alt="" width="32" height="32" class="site-logo-link__img theme-logo theme-logo--light" />
      </span>
      <span class="logo-text truncate" aria-hidden="true">R6s<span class="logo-accent">Cheats</span></span>
    </a>

    <nav class="desktop-nav absolute left-1/2 hidden -translate-x-1/2 items-center gap-5 xl:gap-6 lg:flex" aria-label="Primary">
      {t.nav.map((link) => (
        <a href={link.href} class="nav-link" data-nav-link>{link.label}</a>
      ))}
    </nav>

    <div class="site-header__actions">
      <button
        type="button"
        class="theme-toggle"
        data-theme-toggle
        data-label-light={t.ui.themeLight}
        data-label-dark={t.ui.themeDark}
        aria-label={t.ui.themeLight}
        title={t.ui.themeLight}
      >
        <svg class="theme-toggle__icon theme-toggle__icon--light" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="theme-toggle__icon theme-toggle__icon--dark" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
      <a href={purchaseUrl} class="btn btn-primary desktop-cta hidden lg:inline-flex" aria-label={t.ui.checkoutAria}>{t.ui.browseCheats}</a>
      <button
        type="button"
        class="menu-toggle"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t.ui.menuOpen}
      >
        <svg data-icon-menu width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
        <svg data-icon-close class="hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 6l12 12M18 6 6 18" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    <nav id="mobile-menu" class="mobile-nav" aria-label="Mobile" data-mobile-nav>
      {t.nav.map((link) => (
        <a href={link.href} class="nav-link inline-flex items-center gap-2" data-mobile-link data-nav-link>
          <Icon name={navIcons[link.label] ?? 'crosshair'} size={16} />
          {link.label}
        </a>
      ))}
      <a href={purchaseUrl} class="btn btn-primary mt-2 w-full justify-center" data-mobile-link aria-label={t.ui.checkoutAria}>{t.ui.browseCheatsMobile}</a>
    </nav>
  </div>
</header>
