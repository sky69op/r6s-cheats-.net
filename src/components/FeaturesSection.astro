---
import { t } from '../i18n';
import { featureIcons } from '../data/sectionIcons';
import SectionHeader from './SectionHeader.astro';
import Icon from './icons/Icon.astro';

interface Props {
  showHeader?: boolean;
  showSeeAll?: boolean;
  sectionId?: string;
  class?: string;
}

const {
  showHeader = true,
  showSeeAll = true,
  sectionId = 'features',
  class: className,
} = Astro.props;

const s = t.features;
---

<section
  id={sectionId}
  class:list={['section-shell section-band', className]}
  aria-labelledby={`${sectionId}-title`}
>
  <div class="container section-center">
    {
      showHeader && (
        <SectionHeader eyebrow={s.eyebrow} title={s.title} desc={s.subtitle} titleId={`${sectionId}-title`} />
      )
    }

    <div class:list={['card-grid card-grid-features text-left', showHeader ? 'mt-12' : 'mt-0']} data-reveal-group>
      {s.items.map((item, index) => {
        const checks = item.points ?? item.bullets ?? item.tags.slice(0, 4);
        const centerLast = index === s.items.length - 1 && s.items.length % 2 === 1;

        return (
          <article
            class:list={['feature-block', { 'feature-block--center': centerLast }]}
            data-reveal
            style={`--reveal-delay: ${index * 60}ms`}
          >
            <div class="feature-block-head">
              <span class="icon-wrap icon-wrap-sm feature-block-icon">
                <Icon name={featureIcons[item.title] ?? 'crosshair'} size={16} />
              </span>
              <p class="feature-name">{item.title}</p>
            </div>
            <div class="feature-block-divider" aria-hidden="true"></div>
            <p class="feature-headline">{item.subtitle}</p>
            <p class="feature-desc">{item.desc}</p>
            <ul class="feature-check-grid">
              {checks.map((text) => (
                <li>
                  <Icon name="check" size={14} />
                  <span>{text}</span>
                </li>
              ))}
            </ul>
          </article>
        );
      })}
    </div>

    {
      showSeeAll && (
        <div class="features-see-all mt-8" data-reveal>
          <a href={s.seeAllHref} class="features-see-all-link">
            <span>{s.seeAll}</span>
            <span class="features-see-all-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      )
    }
  </div>
</section>
