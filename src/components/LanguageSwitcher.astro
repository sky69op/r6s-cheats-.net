---
import { getTranslations } from '../i18n';
import { localeLabels, locales, resolveLocale, type MaybeLocale } from '../i18n/config';
import { basePathFromUrl, localizedPath } from '../utils/path';
import Icon from './icons/Icon.astro';

interface Props {
  locale: MaybeLocale;
}

const locale = resolveLocale(Astro.props.locale);
const t = getTranslations(locale);
const pageBasePath = basePathFromUrl(Astro.url.pathname);
---

<div class="lang-switcher" data-lang-switcher>
  <button
    type="button"
    class="lang-switcher__toggle"
    data-lang-toggle
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-label={t.ui.language}
  >
    <Icon name="globe" size={16} class="lang-switcher__icon" />
    <span class="lang-switcher__code">{localeLabels[locale]}</span>
    <Icon name="chevronDown" size={12} class="lang-switcher__chevron" />
  </button>
  <ul class="lang-switcher__menu" role="listbox" data-lang-menu hidden>
    {locales.map((code) => (
      <li role="option" aria-selected={code === locale}>
        <a
          href={localizedPath(code, pageBasePath)}
          class:list={['lang-switcher__option', { 'is-active': code === locale }]}
          hreflang={code}
          lang={code}
        >
          {localeLabels[code]}
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .lang-switcher {
    position: relative;
  }

  .lang-switcher__toggle {
    gap: 0.3125rem;
    width: auto;
    min-width: var(--touch-min);
    padding-inline: 0.625rem;
    font-family: var(--font-heading);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .lang-switcher__icon {
    flex-shrink: 0;
    color: var(--accent);
  }

  .lang-switcher__code {
    line-height: 1;
  }

  .lang-switcher__chevron {
    flex-shrink: 0;
    opacity: 0.65;
  }

  .lang-switcher__menu {
    position: absolute;
    top: calc(100% + 0.375rem);
    right: 0;
    z-index: 120;
    min-width: 5.5rem;
    margin: 0;
    padding: 0.375rem;
    list-style: none;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: var(--shadow-soft);
  }

  .lang-switcher__menu:not([hidden]) {
    display: block;
  }

  .lang-switcher__option {
    display: flex;
    align-items: center;
    min-height: var(--touch-min);
    padding: 0.375rem 0.625rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    transition:
      background var(--motion-fast) var(--motion-ease),
      color var(--motion-fast) var(--motion-ease);
  }

  .lang-switcher__option:hover,
  .lang-switcher__option.is-active {
    background: var(--accent-muted);
    color: var(--text);
  }
</style>
