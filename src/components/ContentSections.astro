---
import { getTranslations, defaultLocale } from '../i18n';
import { localizedPath } from '../utils/path';
import FaqSection from './FaqSection.astro';
import { getLandingFaqs } from '../data/faq';

const locale = Astro.currentLocale ?? defaultLocale;
const t = getTranslations(locale);
const landingFaqs = getLandingFaqs(locale);
---

<section id="faq" aria-labelledby="faq-title">
  <FaqSection
    items={landingFaqs}
    eyebrow={t.faq.eyebrow}
    title={t.faq.title}
    subtitle={t.faq.subtitle}
    titleId="faq-title"
    topicLabels={t.faq.topics}
  />
  <div class="container section-center home-faq-cta flex justify-center">
    <a href={localizedPath(locale, '/faq/')} class="btn btn-outline">{t.faq.viewAll}</a>
  </div>
</section>
