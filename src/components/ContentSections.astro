---
import { t } from '../i18n';
import FaqSection from './FaqSection.astro';
import { getLandingFaqs } from '../data/faq';

const landingFaqs = getLandingFaqs();
---

<section id="faq" aria-labelledby="faq-title">
  <FaqSection
    items={landingFaqs}
    eyebrow={t.faq.eyebrow}
    title={t.faq.title}
    subtitle={t.faq.subtitle}
    titleId="faq-title"
  />
  <div class="container section-center home-faq-cta flex justify-center">
    <a href="/faq/" class="btn btn-outline">View all FAQ</a>
  </div>
</section>
