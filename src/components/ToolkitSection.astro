---
import { getTranslations, defaultLocale } from '../i18n';
import { toolkitIcons } from '../data/sectionIcons';
import SectionHeader from './SectionHeader.astro';
import Icon from './icons/Icon.astro';

const locale = Astro.currentLocale ?? defaultLocale;
const t = getTranslations(locale);

interface Props {
  limit?: number;
  showHeader?: boolean;
  sectionId?: string;
  class?: string;
}

const {
  limit,
  showHeader = true,
  sectionId = 'software',
  class: className,
} = Astro.props;

const s = t.toolkit;
const items = limit ? s.items.slice(0, limit) : s.items;
---

<section
  id={sectionId}
  class:list={['section-shell', className, { 'section-band': showHeader }]}
  aria-labelledby={`${sectionId}-title`}
>
  <div class="container section-center">
    {
      showHeader && (
        <SectionHeader
          eyebrow={s.eyebrow}
          title={s.title}
          desc={s.subtitle}
          titleId={`${sectionId}-title`}
        />
      )
    }

    <div class:list={['card-grid card-grid-3 text-left', showHeader ? 'mt-12' : 'mt-0']} data-reveal-group>
      {items.map((item, i) => (
        <article class="ui-card wz-card" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
          <div class="wz-card-body">
            <div class="card-header-row">
              <span class="ui-icon-wrap icon-wrap icon-wrap-sm">
                <Icon name={toolkitIcons[item.id] ?? 'settings'} size={18} />
              </span>
              <p class="text-xs font-semibold text-(--accent)">{item.label}</p>
            </div>
            <p class="card-title mt-2">{item.title}</p>
            <p class="mt-2 text-sm leading-relaxed text-(--text-muted)">{item.desc}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
