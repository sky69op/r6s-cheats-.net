---
import ResponsiveImage from './ResponsiveImage.astro';
import { HERO_IMAGE_SIZES, HERO_IMAGE_WIDTHS } from '../utils/responsiveImage';

interface Slide {
  src: string;
  alt: string;
  caption: string;
  captionDesc: string;
}

interface Props {
  images: Slide[];
  id: string;
  variant?: 'default' | 'hero';
  desktopOnly?: boolean;
}

const { images, id, variant = 'default', desktopOnly = false } = Astro.props;
const isHero = variant === 'hero';
const imageSizes = isHero ? HERO_IMAGE_SIZES : '(min-width: 1024px) 640px, 100vw';
const imageWidths = isHero ? HERO_IMAGE_WIDTHS : undefined;
---

<div
  class:list={['img-slider', { 'img-slider-hero': variant === 'hero', 'img-slider-desktop-only': desktopOnly }]}
  data-slider={id}
  data-slide-count={images.length}
  data-autoplay
  data-autoplay-interval="5000"
  data-desktop-only={desktopOnly ? '' : undefined}
  style="--slider-interval: 5000ms;"
>
  <div class="img-slider-viewport">
    <div class="img-slider-track">
      {images.map((img, i) => (
        <figure
          class:list={['img-slider-slide', { 'is-active': i === 0 }]}
          data-slide={i}
        >
          <ResponsiveImage
            src={img.src}
            alt={img.alt}
            width={960}
            height={540}
            widths={imageWidths}
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchPriority={isHero && i === 0 ? 'high' : undefined}
            sizes={imageSizes}
            desktopOnly={desktopOnly}
          />
        </figure>
      ))}
    </div>

    {images.length > 1 && (
      <>
        <button type="button" class="img-slider-btn img-slider-prev" data-slider-prev aria-label="Previous slide">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <button type="button" class="img-slider-btn img-slider-next" data-slider-next aria-label="Next slide">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </>
    )}
  </div>

  {images.length > 1 && (
    <div class="img-slider-progress" role="tablist" aria-label="Gallery slides">
      {images.map((_, i) => (
        <button
          type="button"
          class="img-slider-segment"
          data-slider-dot={i}
          role="tab"
          aria-label={`Slide ${i + 1}`}
          aria-selected={i === 0 ? 'true' : 'false'}
        >
          <span class="img-slider-segment-fill" data-slider-segment-fill={i}></span>
        </button>
      ))}
    </div>
  )}
</div>
