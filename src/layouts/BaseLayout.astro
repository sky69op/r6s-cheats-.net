---
import '../styles/global.css';
import { getTranslations, htmlLang, ogLocales, hrefLang, locales, defaultLocale, resolveLocale } from '../i18n';
import {
  canonicalUrl,
  DEFAULT_OG_IMAGE,
  DEFAULT_OG_IMAGE_HEIGHT,
  DEFAULT_OG_IMAGE_WIDTH,
  GA_MEASUREMENT_ID,
  GSC_VERIFICATION,
  absoluteAssetUrl,
  metaDescription,
} from '../config/seo';
import { basePathFromUrl, localizedPath } from '../utils/path';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { CHECKOUT_REDIRECT_MAP } from '../config/affiliate';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const locale = resolveLocale(Astro.currentLocale);
const t = getTranslations(locale);

const {
  title = t.site.title,
  description = t.site.description,
  ogImage = DEFAULT_OG_IMAGE,
  ogImageAlt = title,
  ogType = 'website',
  articlePublishedTime,
  articleModifiedTime,
  noindex = false,
  jsonLd,
} = Astro.props;

const canonical = canonicalUrl(Astro.url.pathname);
const metaDesc = metaDescription(description);
const ogImageUrl = absoluteAssetUrl(ogImage);
const robotsContent = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
const alternateLocales = locales.filter((code) => code !== locale);
const pageBasePath = basePathFromUrl(Astro.url.pathname);
const xDefaultHref = canonicalUrl(localizedPath(defaultLocale, pageBasePath));
---

<!doctype html>
<html lang={htmlLang[locale]} data-theme="r6s">
  <head>
    <meta charset="UTF-8" />
    <script is:inline define:vars={{ checkoutRedirectMap: CHECKOUT_REDIRECT_MAP }}>
      document.addEventListener(
        'click',
        function (event) {
          var target = event.target;
          if (!target || !target.closest) return;
          var link = target.closest('a[href^="/go/"]');
          if (!link || event.defaultPrevented || event.button !== 0) return;
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          if (link.target && link.target !== '_self') return;

          var path = link.pathname || '';
          if (path.charAt(path.length - 1) === '/') path = path.slice(0, -1);
          var slug = path.match(/^\/go\/([^/]+)$/)?.[1];
          var destination = slug && checkoutRedirectMap[slug];
          if (!destination) return;

          event.preventDefault();
          location.replace(destination);
        },
        true,
      );
    </script>
    <script is:inline>
      (function () {
        var storageKey = 'r6scheats-color-mode';
        var userKey = 'r6scheats-color-mode-user';
        var stored = localStorage.getItem(storageKey);
        var userSet = localStorage.getItem(userKey) === '1';
        var mode;
        if (userSet && (stored === 'light' || stored === 'dark')) {
          mode = stored;
        } else {
          mode = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-color-mode', mode);
        document.documentElement.classList.add('fonts-pending');
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.content = mode === 'light' ? '#f8f8fb' : '#7F3DEE';
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={metaDesc} />
    <meta name="author" content={t.site.name} />
    <meta name="robots" content={robotsContent} />
    <meta name="googlebot" content={robotsContent} />
    <meta name="theme-color" content="#7F3DEE" />
    <link rel="canonical" href={canonical} />
    {
      locales.map((code) => (
        <link
          rel="alternate"
          hreflang={hrefLang[code]}
          href={canonicalUrl(localizedPath(code, pageBasePath))}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <script is:inline>
      (function () {
        if (document.documentElement.getAttribute('data-color-mode') !== 'light') return;
        var icon32 = document.querySelector('link[rel="icon"][sizes="32x32"]');
        var icon16 = document.querySelector('link[rel="icon"][sizes="16x16"]');
        var shortcut = document.querySelector('link[rel="shortcut icon"]');
        if (icon32) icon32.href = '/favicon-32-light.png';
        if (icon16) icon16.href = '/favicon-16-light.png';
        if (shortcut) shortcut.href = '/favicon-light.ico';
      })();
    </script>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:width" content={String(DEFAULT_OG_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(DEFAULT_OG_IMAGE_HEIGHT)} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={t.site.name} />
    <meta property="og:locale" content={ogLocales[locale]} />
    {alternateLocales.map((code) => (
      <meta property="og:locale:alternate" content={ogLocales[code]} />
    ))}

    {
      ogType === 'article' && articlePublishedTime && (
        <>
          <meta property="article:published_time" content={articlePublishedTime} />
          <meta
            property="article:modified_time"
            content={articleModifiedTime ?? articlePublishedTime}
          />
          <meta property="article:author" content={t.site.name} />
        </>
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {GSC_VERIFICATION && <meta name="google-site-verification" content={GSC_VERIFICATION} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Manrope:wght@400;500;600&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Manrope:wght@400;500;600&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Manrope:wght@400;500;600&display=swap"
        rel="stylesheet"
      />
    </noscript>

    {jsonLd && <JsonLd data={jsonLd} />}
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <div class="dust-layer" aria-hidden="true"></div>
    <a href="#main-content" class="skip-link">{t.ui.skipLink}</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
